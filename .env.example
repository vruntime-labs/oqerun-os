# Oqerun OS public frontend configuration
#
# Public URL of the separate Oqerun Cloud API deployment.
# Example:
# VITE_OQERUN_CLOUD_API_URL=https://your-oqerun-cloud-api.vercel.app
#
# Never put provider client secrets, refresh tokens, bearer tokens,
# or Redis credentials in VITE_* variables.
VITE_OQERUN_CLOUD_API_URL=

# Server-side Redis connection.
# Vercel's Redis integration supplies REDIS_URL automatically.
# Never commit the real value.
REDIS_URL=

# Server-side Google Drive OAuth configuration.
# Keep these out of VITE_* variables.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32-byte random key encoded as base64.
# Used to encrypt Google refresh tokens before writing them to Redis.
OQERUN_TOKEN_ENCRYPTION_KEY=

# Public origin of the GitHub Pages frontend, for secure popup messaging.
OQERUN_FRONTEND_ORIGIN=
