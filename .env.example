# Oqerun OS public frontend configuration
#
# Public URL of the Cloudflare Worker that powers Oqerun Cloud.
VITE_OQERUN_CLOUD_API_URL=https://oqerun-os.vruntimelabs.workers.dev

# Cloudflare Worker secrets are configured in the Cloudflare dashboard.
# Never put these values in VITE_* variables or commit real values:
#
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OQERUN_TOKEN_ENCRYPTION_KEY=
