# Oqerun OS public frontend configuration
#
# Public URL of the separate Oqerun Cloud API deployment.
# Example:
# VITE_OQERUN_CLOUD_API_URL=https://your-oqerun-cloud-api.vercel.app
#
# Never put provider client secrets, refresh tokens, bearer tokens,
# or other credentials in VITE_* variables.
VITE_OQERUN_CLOUD_API_URL=
